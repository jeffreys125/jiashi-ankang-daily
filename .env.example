# -*- 敏感凭据配置 -*-
# 使用方法：复制本文件为 .env，填入真实值。.env 已被 .gitignore 排除，切勿提交到 git。
# 也可以用系统环境变量（JAZK_* 前缀）代替，适合 systemd / Docker 部署。

# ---- 微信公众号（个人订阅号可用）----
# 获取位置：微信开发者平台 https://developers.weixin.qq.com/platform
#   → 我的业务与服务 → 公众号 → 基础信息 → 开发密钥
# 注意：AppSecret 只在生成时明文显示一次，务必立刻保存；还需要把服务器公网 IP 加入 API IP 白名单。
WX_APPID=
WX_APPSECRET=

# ---- 大模型（用于原创写稿，OpenAI 兼容协议）----
# DeepSeek: https://api.deepseek.com/v1  model: deepseek-chat
# 混元:     https://api.hunyuan.cloud.tencent.com/v1  model: hunyuan
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1  model: qwen-plus
# 智谱:     https://open.bigmodel.cn/api/paas/v4  model: glm-4-flash
# 留空时程序会用「本地模板生成器」产出演示稿（结构完整但非 AI 原创），仅用于跑通流程。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- AI 生图（可选）：正文配图，OpenAI 兼容 /v1/images/generations ----
# 不填也能跑：自动回退到「本地绘制要点提示卡」，免费且零依赖。
# 硅基流动（实测国内可达，约 ¥0.10/张）: https://api.siliconflow.cn/v1
#   控制台 https://cloud.siliconflow.cn → API 密钥；模型名以控制台「图像生成」列表为准
# 阿里百炼（¥0.20/张，新用户有免费额度）: https://dashscope.aliyuncs.com/compatible-mode/v1
#   模型: wan2.7-image   （Key 为 DASHSCOPE_API_KEY，需开通百炼）
# 注意：AI 生图按张计费，每天 2 张约 ¥0.2~0.4；生成的图片会带「AI 生成」显式声明。
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.siliconflow.cn/v1
IMAGE_MODEL=Kwai-Kolors/Kolors
IMAGE_SIZE=1024x1024

# ---- 通知（可选）：草稿建好后推送到手机 ----
# Server酱: https://sctapi.ftqq.com/<SENDKEY>.send
# 企业微信群机器人: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<KEY>
NOTIFY_WEBHOOK=
